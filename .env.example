# Local development configuration. Copy to .env and replace credentials.
STOCKRNN_PLATFORM_ENV=development
STOCKRNN_PLATFORM_API_PREFIX=/api
STOCKRNN_STORAGE_BACKEND=mysql
DATABASE_URL=mysql+pymysql://stockrnn_user:change-me@127.0.0.1:3306/stockrnn_platform
REDIS_URL=redis://127.0.0.1:6379/0
STOCKRNN_ARTIFACT_ROOT=output/platform

