FROM python:3.11-slim

WORKDIR /app
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY research_platform/backend/requirements.txt /app/requirements-platform.txt
RUN pip install --no-cache-dir --index-url ${PIP_INDEX_URL} -r /app/requirements-platform.txt

COPY . /app
ENV PYTHONPATH=/app
EXPOSE 8000

CMD ["uvicorn", "research_platform.backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
