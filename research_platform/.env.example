# Copy to a local .env file; never commit real credentials.
STOCKRNN_PLATFORM_ENV=development
STOCKRNN_PLATFORM_APP_NAME=StockRNN Research Platform
STOCKRNN_PLATFORM_API_PREFIX=/api

# Use the existing Docker MySQL service/database.
# Example only; replace credentials and host for your environment.
DATABASE_URL=mysql+pymysql://stockrnn_user:change-me@mysql:3306/stockrnn_platform

# Existing or dedicated Redis service for Celery task queues.
REDIS_URL=redis://redis:6379/0

# Model/report/checkpoint artifacts remain on disk or object storage.
STOCKRNN_ARTIFACT_ROOT=output/platform
# Use mysql for the running platform; use memory only for isolated API tests.
STOCKRNN_STORAGE_BACKEND=mysql
